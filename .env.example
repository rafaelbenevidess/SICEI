# Empresa licenciada desta instalação (aparece no login e no rodapé)
SICEI_LICENCIADA="DDA Usinagem Industrial"

# Banco: uma instalação por empresa, com a empresa no nome (sicei_<empresa>_app/_owner)
# A aplicação usa a URL com pooling; as migrations usam a direta.
DATABASE_URL="postgresql://sicei_dda_app:senha@localhost:5432/sicei_dda"
DIRECT_URL="postgresql://sicei_dda_owner:senha@localhost:5432/sicei_dda"

# Endereço público do sistema (usado nos QR codes e nos e-mails)
APP_URL="http://localhost:3000"

# Segredo da rotina diária (/api/cron/diario)
CRON_SECRET=""

# SMTP para os avisos de estoque (RN-19)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SICEI <sicei@ddausinagem.com.br>"
