@startuml atividades-saida-qr
' Diagrama de atividades 1: localizar o item pela etiqueta QR e preencher a saída (RF-08, RF-22)
' Fonte: src/components/LeitorQr.tsx, src/domain/posicao.ts, src/app/(app)/p,
'        src/app/(app)/movimentacoes/nova
!include estilo.iuml
skinparam ActivityBackgroundColor #F4F7FB
skinparam ActivityBorderColor #1F3A5F
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ActivityDiamondBorderColor #1F3A5F
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneTitleFontColor #1F3A5F
skinparam defaultFontSize 13

title SICEI · Atividades (1/3): registrar saída pela etiqueta QR, no celular

|Almoxarife|
start
:Toca em "Ler QR"
na barra inferior;
|#F7F9FC|SICEI (navegador)|
if (Câmera disponível\ne permitida?) then (não)
  :Explica o motivo e mostra
  o campo do código da posição;
  :Almoxarife digita o código
  (ex.: "a1g3c4");
else (sim)
  repeat
    :Analisa a imagem no próprio aparelho
    (BarcodeDetector ou jsQR, a cada 200 ms:
    nenhuma imagem vai ao servidor);
  repeat while (QR é etiqueta do SICEI?) is (não: avisa e continua lendo)
  ->sim;
endif
|SICEI (servidor)|
:Confere a sessão e interpreta o código
(a1g3c4 → A01-G03-C04);
if (Posição tem item?) then (não)
  :Mostra "posição vazia";
  stop
else (sim)
endif
:Abre a página do item com
"Registrar saída" à mão;
|Almoxarife|
repeat
  :Informa quantidade, destino,
  ordem de produção e quem retirou;
  |SICEI (navegador)|
  :Prévia com as funções de domain/:
  saldo depois e status (OK, Atenção,
  Crítico, Zerado);
repeat while (Quantidade maior\nque o saldo?) is (sim: "Saída recusada",\nconfirmar bloqueado)
->não;
|Almoxarife|
:Confirma a saída;
|SICEI (servidor)|
:Grava a saída
(ver diagrama 2/3);
|SICEI (navegador)|
:Mostra a confirmação: saldo antes e agora
e aviso se o item entrou em alerta;
|Almoxarife|
if (Ler outra etiqueta?) then (sim)
  :Volta para "Ler QR";
else (não)
endif
stop
@enduml
