{
  "name": "simi",
  "version": "0.1.0",
  "private": true,
  "description": "SIMI: controle de estoque de pastilhas industriais (DDA Metalúrgica)",
  "scripts": {
    "dev": "next dev",
    "build": "npm run test:relatorio && next build",
    "build:app": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unidade",
    "test:watch": "vitest --project unidade",
    "test:ui": "vitest --ui --project unidade",
    "test:cobertura": "vitest run --project unidade --coverage",
    "test:relatorio": "vitest run --project unidade --coverage --reporter=default --reporter=html"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
